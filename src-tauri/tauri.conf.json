{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "PANELS FREE",
  "version": "0.1.0",
  "identifier": "com.panelsfree.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PANELS FREE",
        "width": 1400,
        "height": 850,
        "minWidth": 950,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
